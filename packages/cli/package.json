{
	"name": "delacour",
	"version": "0.5.1",
	"description": "Add React Native components to your Expo app. You own the code.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/delacournz/delacour-ui.git",
		"directory": "packages/cli"
	},
	"keywords": [
		"expo",
		"react-native",
		"cli",
		"components",
		"uniwind",
		"tailwind"
	],
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"delacour": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"build": "tsdown",
		"build:check": "bun scripts/check-bundle.ts",
		"dev": "tsdown --watch",
		"registry:build": "bun src/registry/cli.ts",
		"verify:expo": "bun scripts/verify-expo.ts",
		"check": "biome check ./src",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"prepublishOnly": "bun run build && bun run build:check"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@delacour/biome-config": "workspace:*",
		"@delacour/design-system": "workspace:*",
		"@delacour/skills": "workspace:*",
		"@delacour/tsconfig": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@types/bun": "^1.3.8",
		"@types/node": "^22.15.0",
		"commander": "^15.0.0",
		"node-diff3": "^3.2.1",
		"picocolors": "^1.1.1",
		"tinyexec": "^1.3.0",
		"tsdown": "^0.23.1",
		"typescript": "~6.0.3",
		"zod": "^4.6.7"
	}
}
